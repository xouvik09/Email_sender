# Copy to .env and fill in. .env is git-ignored.
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=your@email.com
# Gmail requires an app password, not your account password.
SMTP_PASSWORD=your-app-password
# Defaults: 465 with SSL, 587 when SMTP_USE_SSL=false (STARTTLS).
SMTP_PORT=465
SMTP_USE_SSL=true
# Optional From override and display name.
SMTP_SENDER=
SMTP_SENDER_NAME=
